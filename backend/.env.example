# ============================================================
# Variables de Entorno para MiBarber (Supabase + PostgreSQL)
# ============================================================

# OPCION 1: URL Completa de conexión (Supabase / Render / Railway)
# Puedes copiar el connection string de Supabase (Settings -> Database -> Connection string -> URI o Transaction pooler)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# OPCION 2: Variables individuales de Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_password_de_supabase

# Puerto del servidor (opcional, por defecto 8080)
PORT=8080
